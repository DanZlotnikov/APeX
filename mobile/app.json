{
  "expo": {
    "name": "APeX",
    "slug": "apex-athlete-performance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.apexathletics.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to record short movement exercises.",
        "NSPhotoLibraryUsageDescription": "Select an exercise video from your library for processing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.apexathletics.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow APeX to use the camera to record movement exercises.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow APeX to select an exercise video from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00D4BC"
        }
      ],
      "./plugins/withoutRecordAudio.js"
    ],
    "extra": {
      "eas": {
        "projectId": "165e3b8c-e1f4-4424-94bc-74bccaf9f07a"
      }
    }
  }
}
