# Secrets that must never be committed -- see ANDROID_SUBMISSION_PLAN.md
# (google-services.json is NOT here: it's a public Firebase client
# identifier, not a credential, and is intentionally committed)
mobile/google-play-service-account.json

# Native projects are generated by `expo prebuild` from app.json (EAS does
# this on every build); local ones are only for emulator testing.
mobile/android/
mobile/ios/
backend/server/.gpu_restarts.json
